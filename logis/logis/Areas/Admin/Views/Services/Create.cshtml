@model Service

<form class="user" method="post">
    <div class="form-group row">
        <div class="col-sm-6 mb-3 mb-sm-0">
            <input asp-for="Title" class="form-control form-control-user" id="exampleFirstName"
                   placeholder="Title">
        </div>
        <div class="col-sm-6">
            <input asp-for="Decription" class="form-control form-control-user" id="exampleLastName"
                   placeholder="Decription">
        </div>
    </div>
    <div class="form-group">
        <input asp-for="Image" class="form-control form-control-user" id="exampleInputEmail"
               placeholder="Image">
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary btn-user btn-block">Create</button>
    </div>
</form>